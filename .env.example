PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
WORLD_ID_APP_ID=app_
# The same app id, for the web app's World ID widget
NEXT_PUBLIC_WORLD_APP_ID=app_
NEXT_PUBLIC_WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
NEXT_PUBLIC_WORLD_ENVIRONMENT=staging
PORT=3001
# Where the web app and the extension reach the API
NEXT_PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgres://localhost:5432/supercall
# Optional: cap DB connections (1 for a local PGlite)
DATABASE_POOL_MAX=

# Arkiv (Rabdi chain)
ARKIV_WRITER_ADDRESS=
ARKIV_PRIVATE_KEY=
ARKIV_API_KEY=
ARKIV_RPC_URL=
ARKIV_LIVE_TESTS=

# Definitive Flash
FLASH_API_KEY=

# Hisaab writer (optional: without it, registerCall is skipped and nobody can copy)
HISAAB_WRITER_KEY=

# Worker: settlement key (the account that settles calls on Hisaab)
SETTLER_PRIVATE_KEY=
SETTLER_ADDRESS=

# Arc chain RPC (optional: falls back to the default)
ARC_RPC_URL=

# X live feed (optional: without both, no inbound posts)
X_BEARER_TOKEN=
X_WEBHOOK_ID=
X_API_SECRET=

# Post reader (optional: without one, no new posts are read)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS: comma-separated origins the web app runs on
WEB_ORIGIN=http://localhost:3000
